generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["crm"]
}

enum RepRole {
  rep
  manager

  @@schema("crm")
}

enum RepType {
  field
  remote

  @@schema("crm")
}

enum CreditTerm {
  prepay
  account

  @@schema("crm")
}

enum AccountType {
  prospect
  customer

  @@schema("crm")
}

enum Stage {
  new_lead
  approached
  quote_sent
  payment_cleared
  dispatched

  @@schema("crm")
}

enum ActivityType {
  call
  email
  visit

  @@schema("crm")
}

// id matches auth.users.id from Supabase Auth — no FK constraint here,
// Prisma isn't managing the auth schema. Insert a matching row here
// yourself right after each rep signs up.
model Rep {
  id        String     @id @db.Uuid
  name      String
  type      RepType
  role      RepRole    @default(rep)
  accounts  Account[]
  activity  Activity[]
  budgetTargets BudgetTarget[]
  tasks         Task[]
  // Default 10 cold calls/day — overdue, incomplete cold calls
  // roll forward automatically; this caps how many count as "today".
  // A fixed visit never rolls regardless of this limit.
  dailyColdCallLimit Int @default(10) @map("daily_cold_call_limit")
  // How many suggested outreach items show on the Planner each day,
  // pulled from the rep's assigned regions — set by the rep
  // themselves, distinct from dailyColdCallLimit which caps manually
  // scheduled tasks.
  dailyNewLeadCount  Int @default(5) @map("daily_new_lead_count")
  dailyInactiveCount Int @default(5) @map("daily_inactive_count")
  // The day the planner last auto-filled this rep's list (once per day).
  lastAutoPlanDate   DateTime? @map("last_auto_plan_date") @db.Date
  regions            RepRegion[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("reps")
  @@schema("crm")
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  region        String
  repId         String      @map("rep_id") @db.Uuid
  rep           Rep         @relation(fields: [repId], references: [id])
  credit        CreditTerm
  type          AccountType @default(prospect)
  stage         Stage       @default(new_lead)

  // Links this account to its DEAR customer record, set once the
  // sync job matches them by name for the first time. Every sync
  // after that uses this instead of matching by name again.
  dearCustomerId String?    @unique @map("dear_customer_id")

  // Contact details — while type is 'prospect', reps own this data
  // directly. Once type flips to 'customer' (onboarded into DEAR),
  // the Cin7 sync job becomes the writer here and this is a cache of
  // DEAR's record, not CRM's own data anymore.
  contactName   String?     @map("contact_name")
  phone         String?
  email         String?
  address       String?

  // Set by a rep when they want a reminder, distinct from the
  // inactivity flag (which is inferred from lastOrderAt).
  nextFollowUpAt DateTime?  @map("next_follow_up_at")

  // Cached spend figures, written by the Cin7 sync job later.
  spend30       Float       @default(0) @map("spend_30")
  spend90       Float       @default(0) @map("spend_90")
  spend365      Float       @default(0) @map("spend_365")
  lastOrderAt   DateTime?   @map("last_order_at")
  // Average days between this account's own past orders — used to
  // flag "inactive" relative to THEIR normal pace, not one fixed
  // number for every account. Null until they have 2+ paid orders.
  avgOrderGapDays Int?      @map("avg_order_gap_days")
  // Not a real sales target — a one-off retail buyer, merchandise
  // order, or similar. Kept (not deleted) for the DEAR link and
  // history, but hidden from normal working views.
  archived      Boolean     @default(false)
  // Real business category from DEAR's customer record
  // (AdditionalAttribute1) — e.g. "Gift and concept stores", "Toy",
  // "Pharmacy". Null for accounts synced before this field was found.
  category      String?
  // Marketing, warranty, or other internal/non-commercial orders —
  // real transactions, but shouldn't count toward a rep's sales
  // performance. Kept fully visible (unlike archived), just excluded
  // from budget/ledger/performance figures specifically.
  misc          Boolean     @default(false)

  activity      Activity[]
  quotes        Quote[]
  tasks         Task[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("accounts")
  @@schema("crm")
}

model Activity {
  id         String       @id @default(uuid()) @db.Uuid
  accountId  String       @map("account_id") @db.Uuid
  account    Account      @relation(fields: [accountId], references: [id])
  repId      String       @map("rep_id") @db.Uuid
  rep        Rep          @relation(fields: [repId], references: [id])
  type       ActivityType
  note       String
  photoUrl   String?      @map("photo_url")
  occurredAt DateTime     @default(now()) @map("occurred_at")

  @@map("activity")
  @@schema("crm")
}

// Mirrors what the Cin7/DEAR sync job pulls in later. The sync job
// upserts here on `number`; nothing else should write to this table.
model Quote {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id])
  number    String   @unique
  amount    Float // exact order total incl. cents
  sentAt      DateTime  @map("sent_at")
  invoiceDate       DateTime? @map("invoice_date")
  paid              Boolean   @default(false)
  // DEAR's own Status field (e.g. "BACKORDERED", "PICKED", "SHIPPED",
  // "COMPLETED") — captured as-is rather than remapped, since the
  // documented enum has more real states than our own Stage does.
  fulfillmentStatus String?   @map("fulfillment_status")

  // Per-order shipping details — a parent account (e.g. "Toy and
  // Tales") can bill centrally while shipping to different named
  // stores/franchises per order. shippingCompany holds that store
  // name when DEAR's ShippingAddress.Company is set; shippingAddress
  // is the formatted delivery address for that specific order.
  shippingCompany String?   @map("shipping_company")
  shippingAddress String?   @map("shipping_address")

  // The order's own reference text (e.g. contains "warranty" or
  // "marketing" for one-off internal orders) — stored so those can
  // be identified and cleaned up later without re-fetching from DEAR.
  reference       String?
  source    String   @default("cin7")
  syncedAt  DateTime @default(now()) @map("synced_at")
  lines     QuoteLine[]
  // Set when the order is a warranty replacement or marketing/sample
  // giveaway — a real order, but not a commercial sale. Drives the
  // Misc page's two tabs and is excluded from all performance figures.
  miscType  String?  @map("misc_type") // "marketing" | "warranty" | null

  // Full order detail captured by the sync, so the Orders page can show
  // everything a rep would otherwise open DEAR for.
  dearSaleId      String?  @map("dear_sale_id")
  invoiceNumber   String?  @map("invoice_number")
  paymentStatus   String?  @map("payment_status")   // DEAR CombinedPaymentStatus
  shippingStatus  String?  @map("shipping_status")  // DEAR CombinedShippingStatus
  pickingStatus   String?  @map("picking_status")   // DEAR CombinedPickingStatus; allocation ends at pick
  lineFulfilment  Json     @default("{}") @map("line_fulfilment") // { "<sku>": { picked, shipped, backordered } }
  fulfilments     Json     @default("[]") // [{ number, pick, pack, ship, shippedAt, lines: [{ sku, name, qty }], shipments }]
  orderContact    String?  @map("order_contact")
  orderEmail      String?  @map("order_email")
  orderPhone      String?  @map("order_phone")
  shippingDetails Json?    @map("shipping_details") // { company, contact, line1, line2, city, state, postcode, country }
  shipments       Json     @default("[]")           // [{ date, carrier, trackingNumber, trackingUrl }]
  taxTotal        Float?   @map("tax_total")
  total           Float?   // exact order total incl. tax, from DEAR
  amountPaid      Float?   @map("amount_paid") // paid so far, across all invoices
  // Every invoice and credit note on the order, as DEAR records them, and
  // the balance from them: invoiced - paid - credited (see sync-sales).
  invoices        Json     @default("[]") // [{ number, date, dueDate, status, total, paid }]
  creditNotes     Json     @default("[]") @map("credit_notes") // [{ number, date, status, total, refunded }]
  invoicedTotal   Float?   @map("invoiced_total")
  creditedTotal   Float?   @map("credited_total")
  amountDue       Float?   @map("amount_due") // null = not synced with invoice detail yet
  // Credit the customer still has from this order (credit notes not applied
  // or refunded, prepayments not applied). Balance = amount due - this.
  unappliedCredit Float?   @map("unapplied_credit")
  memo            String?

  // Every account-list request filters/includes quotes by these
  // exact combinations (misc filtering, the History badge lookup) —
  // without these, Postgres was scanning the whole table per account.
  @@index([accountId])
  @@index([accountId, miscType])
  @@index([accountId, source])
  @@map("quotes")
  @@schema("crm")
}

// One row, tracks when the Cin7 sync job last ran successfully so
// it knows how far back to look next time.
model SyncState {
  key           String   @id
  lastSyncedAt  DateTime @map("last_synced_at")
  // Tie-breaker for when many DEAR records share the exact same
  // Updated timestamp (confirmed real — a bulk import or batch edit
  // can touch thousands of records at one instant). Without this,
  // a timestamp-only cursor can loop on the same tied group forever.
  lastId        String?  @map("last_id")

  @@map("sync_state")
  @@schema("crm")
}

// A rep's own quarterly sales target — this is a human-entered number,
// not something DEAR has any concept of. Calendar quarters (Q1 =
// Jan-Mar) to match how the sales team already tracks it.
model BudgetTarget {
  id        String   @id @default(uuid()) @db.Uuid
  repId     String   @db.Uuid
  rep       Rep      @relation(fields: [repId], references: [id])
  year      Int
  quarter   Int      // 1-4
  amount    Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([repId, year, quarter])
  @@map("budget_targets")
  @@schema("crm")
}

// A planned cold call or visit for a rep on a given day. Fixed
// (visit) tasks never move. Non-fixed (cold_call) tasks roll to the
// next day automatically if left incomplete, capped at the rep's
// own dailyColdCallLimit so a backlog drains gradually instead of
// piling onto one day.
model Task {
  id            String   @id @default(uuid()) @db.Uuid
  repId         String   @db.Uuid
  rep           Rep      @relation(fields: [repId], references: [id])
  accountId     String   @db.Uuid
  account       Account  @relation(fields: [accountId], references: [id])
  type          TaskType
  scheduledDate DateTime @map("scheduled_date") @db.Date
  fixed         Boolean  @default(false)
  completed     Boolean  @default(false)
  completedAt   DateTime? @map("completed_at")
  note          String?
  // Why the planner added it automatically: 'new_lead' or 'inactive'.
  // null = a person scheduled it.
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tasks")
  @@schema("crm")
}

enum TaskType {
  cold_call
  visit

  @@schema("crm")
}

// One line item from a real order — SKU, product name, brand,
// quantity, price. Brand comes from DEAR's Product record (a real
// flat field, confirmed from a live sample), not the sale line
// itself, which only carries SKU/Name/Quantity/Price.
// A rep can be assigned to one or several states/regions by a
// manager. Determines which accounts show up in their suggested
// outreach list on the Planner — not an access-control mechanism
// (RLS/role checks still govern what a rep can see), just a
// territory assignment for suggestions.
model RepRegion {
  id     String @id @default(uuid()) @db.Uuid
  repId  String @map("rep_id") @db.Uuid
  rep    Rep    @relation(fields: [repId], references: [id])
  region String

  @@unique([repId, region])
  @@map("rep_regions")
  @@schema("crm")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sku         String
  productName String  @map("product_name")
  brand       String?
  quantity    Float
  unitPrice   Float   @map("unit_price")
  discount    Float   @default(0) // percent, as DEAR stores it
  tax         Float   @default(0)
  lineTotal   Float   @map("line_total")

  @@map("quote_lines")
  @@schema("crm")
}

// DEAR products and stock, kept current by the sync-products Edge
// Function. The app reads stock from here only, never from DEAR.
model Product {
  sku           String    @id
  dearId        String?   @map("dear_id")
  name          String
  brand         String?
  category      String?
  uom           String?
  status        String?
  onHand        Float     @default(0) @map("on_hand")
  allocated     Float     @default(0)
  available     Float     @default(0)
  onOrder       Float     @default(0) @map("on_order")
  locations     Json      @default("[]")
  prices        Json      @default("{}") // { "<DEAR price tier name>": price }
  barcode       String?
  attributes    Json      @default("{}") // DEAR custom fields, e.g. { "AdditionalAttribute1": "2" }
  imageUrl      String?   @map("image_url") // loaded from the team's price lists; the DEAR sync never touches it
  updatedAt     DateTime  @default(now()) @map("updated_at")
  stockSyncedAt DateTime? @map("stock_synced_at")

  @@map("products")
  @@schema("crm")
}

// DEAR purchase orders, kept current by the sync-purchases Edge
// Function. Powers incoming POs and purchase history on Products.
model Purchase {
  id              String         @id // DEAR purchase ID
  number          String?
  supplier        String?
  status          String?
  receivingStatus String?        @map("receiving_status")
  orderDate       DateTime?      @map("order_date")
  requiredBy      DateTime?      @map("required_by")
  syncedAt        DateTime       @default(now()) @map("synced_at")
  lines           PurchaseLine[]

  @@map("purchases")
  @@schema("crm")
}

model PurchaseLine {
  id               String    @id @default(uuid()) @db.Uuid
  purchaseId       String    @map("purchase_id")
  purchase         Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sku              String
  productName      String    @map("product_name")
  quantityOrdered  Float     @default(0) @map("quantity_ordered")
  quantityReceived Float     @default(0) @map("quantity_received")
  lastReceivedAt   DateTime? @map("last_received_at")

  @@map("purchase_lines")
  @@schema("crm")
}

// B2B portal abandoned carts, one row per cart line as Cin7 exports
// them. A cart is all lines sharing abandonedAt + email. Accounts and
// SKUs are matched at read time, not stored.
model AbandonedCartLine {
  id          String   @id @default(uuid()) @db.Uuid
  abandonedAt DateTime @map("abandoned_at")
  contact     String
  email       String
  productName String   @map("product_name")
  quantity    Float    @default(0)
  price       Float    @default(0)
  total       Float    @default(0)
  importedAt  DateTime @default(now()) @map("imported_at")

  @@unique([abandonedAt, email, productName])
  @@map("abandoned_cart_lines")
  @@schema("crm")
}
